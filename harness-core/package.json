{
  "name": "@thetis/harness-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The default harness: the system prompt that teaches self-extension, and every installed tool attached to the call.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist/test/"
  },
  "peerDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "devDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "thetis": {
    "type": "loader",
    "steps": [
      {
        "id": "system-prompt",
        "phase": "prompt",
        "export": "systemPrompt"
      },
      {
        "id": "attach-tools",
        "phase": "tools",
        "export": "attachTools"
      },
      {
        "id": "record-call",
        "phase": "after",
        "export": "recordCall"
      }
    ]
  }
}
