{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "thetis://internal/web-command/1",
  "type": "object", "required": ["type"], "properties": {
    "type": { "type": "string", "maxLength": 64 }, "id": { "type": "string", "maxLength": 256 },
    "text": { "type": "string", "maxLength": 65536 }, "from": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 96 },
    "scope": { "enum": ["mine", "everyone"], "description": "whose conversations a list asks for" },
    "reach": { "enum": ["person", "deployment"], "description": "who an install reaches" },
    "request": { "type": "string", "maxLength": 64 }, "package": { "type": "string", "maxLength": 64 },
    "verb": { "type": "string", "maxLength": 32 }, "args": { "type": "object" },
    "model": { "type": "string", "minLength": 1, "maxLength": 128, "description": "the model a conversation is being set to" },
    "mode": { "type": "string", "minLength": 1, "maxLength": 32, "description": "how much a conversation may do; the environment names the ones it offers" },
    "attachments": { "type": "array", "maxItems": 8, "items": {
      "type": "object", "required": ["name", "mime", "bytes", "hash", "path"], "properties": {
        "name": { "type": "string", "maxLength": 256 }, "mime": { "type": "string", "maxLength": 128 },
        "bytes": { "type": "integer", "minimum": 0 }, "hash": { "type": "string", "maxLength": 128 },
        "path": { "type": "string", "maxLength": 1024 }
      }, "additionalProperties": true
    } }
  }, "additionalProperties": true
}
