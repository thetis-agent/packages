    "@thetis/host": "^0.1.0",
    "@thetis/kernel": "^0.1.0",
    "@thetis/door": "^0.1.0",
    "@thetis/gateway-login": "^0.1.0"
  },
  "thetis": {
    "type": "gateway",
    "service": {
