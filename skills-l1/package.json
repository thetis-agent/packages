{
  "name": "skills-l1",
  "version": "1.0.0",
  "type": "module",
  "exports": "./index.ts",
  "stages": "./index.ts",
  "requires": {
    "contract/skills": "^1",
    "contract/turn-events": "^1",
    "contract/surface": "^1"
  },
  "provides": {
    "stage/retrieve": "1.0.0",
    "panel/skills": "1.0.0",
    "renderer/load_skill": "1.0.0"
  },
  "surface": {
    "v": "1",
    "panels": [
      { "id": "skills", "label": "Skills", "hint": "Skills \u2014 the catalog this conversation carries, and what the model has loaded", "entry": "/surface/skills-l1/panel.js" }
    ],
    "renderers": [
      { "kind": "tool-call", "entry": "/surface/skills-l1/rows.js" },
      { "kind": "tool-result", "entry": "/surface/skills-l1/rows.js" }
    ]
  },
  "envelope": {
    "requires": [],
    "provides": [],
    "spawn": {
      "scope": "person",
      "network": "none"
    }
  },
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "resources": {
        "type": "boolean",
        "default": true
      },
      "loadBytes": {
        "type": "integer",
        "minimum": 1,
        "default": 262144
      }
    },
    "additionalProperties": false
  }
}
