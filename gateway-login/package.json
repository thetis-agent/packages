{
  "name": "@thetis/gateway-login",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The sign-in page: turns a password into the cookie every gateway checks.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "devDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "thetis": {
    "type": "gateway",
    "config": {
      "secure": {
        "type": "boolean",
        "default": false,
        "scope": "system",
        "help": "Adds Secure to the login cookie; set it when TLS terminates in front of the door."
      }
    },
    "service": {
      "export": "startService"
    }
  }
}
