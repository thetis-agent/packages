{
  "name": "@thetis/gateway-login",
  "version": "0.2.0",
  "license": "MIT",
  "description": "The sign-in page: turns a password into the cookie every gateway checks, under the agent's own name and picture.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -b"
  },
  "thetis": {
    "type": "gateway",
    "label": "sign-in page",
    "summary": "The sign-in page.",
    "config": {
      "secure": {
        "type": "boolean",
        "default": false,
        "scope": "system",
        "help": "Adds Secure to the login cookie; set it when TLS terminates in front of the door."
      }
    },
    "service": {
      "export": "startService"
    }
  },
  "peerDependencies": {
    "@thetis/harness-core": "^0.7.0",
    "@thetis/runtime": "^0.2.0"
  },
  "devDependencies": {
    "@thetis/harness-core": "^0.7.0",
    "@thetis/runtime": "file:../.."
  }
}
