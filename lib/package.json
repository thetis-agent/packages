    "./mounts": {
      "types": "./dist/src/mounts.d.ts",
      "default": "./dist/src/mounts.js"
    },
    "./pkg-fs": {
      "types": "./dist/src/pkg-fs.d.ts",
      "default": "./dist/src/pkg-fs.js"
    },
    "./crypto": {
      "types": "./dist/src/crypto.d.ts",
