{
  "name": "@thetis/marketplace",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Mirrors package registries and writes the searchable index the control panel reads.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist/test/"
  },
  "peerDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "devDependencies": {
    "@thetis/contracts": "^0.1.0"
  },
  "thetis": {
    "type": "service",
    "config": {
      "registries": {
        "type": "array",
        "scope": "system",
        "default": [
          {
            "name": "thetis",
            "url": "https://github.com/thetis-agent/packages.git"
          }
        ],
        "help": "The git registries to mirror, each { name, url }; name defaults to the last path segment of url, and [] indexes nothing and keeps the refresh off the network."
      },
      "refreshMinutes": {
        "type": "number",
        "default": 30,
        "scope": "system",
        "help": "How many minutes between refreshes of the mirrors and the index."
      }
    },
    "service": {
      "export": "startService"
    }
  },
  "dependencies": {
    "@thetis/lib": "^0.1.0"
  }
}
