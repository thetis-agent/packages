{
  "name": "@flat/skills",
  "version": "1.0.0",
  "description": "Puts every capability body in the prompt, in corpus order, until a byte budget runs out.",
  "type": "module",
  "main": "index.js",
  "thetis": {
    "type": "loader",
    "steps": [
      {
        "id": "bench-import",
        "phase": "bench",
        "export": "importCorpus"
      },
      {
        "id": "inject",
        "phase": "prompt",
        "export": "inject"
      },
      {
        "id": "bench-report",
        "phase": "bench",
        "export": "benchReport"
      }
    ],
    "bench": {
      "suites": [
        "skill-recall@1"
      ],
      "corpus": "caps@1",
      "peerGroup": "skills",
      "importer": "importCorpus",
      "adapter": "benchReport"
    }
  }
}
