{
  "name": "@thetis/ui-admin",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The admin sections of the web gateway's control panel: people, models, configuration, mounts, activity, workspaces, and overview.",
  "type": "module",
  "main": "index.js",
  "thetis": {
    "type": "ui",
    "ui": {
      "dir": "ui",
      "entry": "index.js",
      "style": "index.css",
      "panel": [
        {
          "id": "people",
          "label": "People",
          "note": "Who can sign in, and what they may do.",
          "role": "admin",
          "order": 20
        },
        {
          "id": "models",
          "label": "Models",
          "note": "Which model answers by default, and what the providers serve.",
          "role": "admin",
          "order": 30
        },
        {
          "id": "configuration",
          "label": "Package settings",
          "note": "What this package is configured with, and what is missing.",
          "role": "admin",
          "order": 32,
          "under": "packages"
        },
        {
          "id": "mounts",
          "label": "Mounts",
          "note": "Which host directories are bound into whose space.",
          "role": "admin",
          "order": 35
        },
        {
          "id": "activity",
          "label": "Activity",
          "note": "What happened: who did what, and when.",
          "role": "admin",
          "order": 40
        },
        {
          "id": "workspaces",
          "label": "Workspaces",
          "note": "What code each workspace is running, and how to put new code into service.",
          "role": "admin",
          "order": 45
        },
        {
          "id": "overview",
          "label": "Overview",
          "note": "How this installation is set up.",
          "role": "admin",
          "order": 50
        }
      ],
      "commands": [
        {
          "verb": "users",
          "export": "users",
          "label": "List the people",
          "role": "admin"
        },
        {
          "verb": "user-create",
          "export": "userCreate",
          "label": "Add a person",
          "role": "admin"
        },
        {
          "verb": "user-role",
          "export": "userRole",
          "label": "Change a role",
          "role": "admin"
        },
        {
          "verb": "user-status",
          "export": "userStatus",
          "label": "Suspend or activate",
          "role": "admin"
        },
        {
          "verb": "user-password",
          "export": "userPassword",
          "label": "Set a password",
          "role": "admin"
        },
        {
          "verb": "user-remove",
          "export": "userRemove",
          "label": "Remove a person",
          "role": "admin"
        },
        {
          "verb": "models",
          "export": "models",
          "label": "List the models",
          "role": "admin"
        },
        {
          "verb": "config",
          "export": "config",
          "label": "Read the configuration",
          "role": "admin"
        },
        {
          "verb": "config-list",
          "export": "configList",
          "label": "What every package is configured with",
          "role": "admin"
        },
        {
          "verb": "package-info",
          "export": "packageInfo",
          "label": "What one package is and where it stands",
          "role": "admin"
        },
        {
          "verb": "config-show",
          "export": "configShow",
          "label": "What one package is configured with",
          "role": "admin"
        },
        {
          "verb": "config-set",
          "export": "configSet",
          "label": "Set one configuration key",
          "role": "admin"
        },
        {
          "verb": "config-unset",
          "export": "configUnset",
          "label": "Clear one configuration key",
          "role": "admin"
        },
        {
          "verb": "config-reload",
          "export": "configReload",
          "label": "Re-read the configuration file",
          "role": "admin"
        },
        {
          "verb": "journal",
          "export": "journal",
          "label": "Read the journal",
          "role": "admin"
        },
        {
          "verb": "mounts-list",
          "export": "mountsList",
          "label": "List the mounts",
          "role": "admin"
        },
        {
          "verb": "mounts-set",
          "export": "mountsSet",
          "label": "Set a person's mounts",
          "role": "admin"
        },
        {
          "verb": "mounts-browse",
          "export": "mountsBrowse",
          "label": "List the directories under a host path",
          "role": "admin"
        },
        {
          "verb": "fence-reload",
          "export": "fenceReload",
          "label": "Reload a workspace",
          "role": "admin"
        },
        {
          "verb": "status",
          "export": "status",
          "label": "What the daemon and every workspace are running",
          "role": "admin"
        },
        {
          "verb": "restart-request",
          "export": "restartRequest",
          "label": "Ask the daemon to restart",
          "role": "admin"
        }
      ]
    }
  },
  "dependencies": {
    "@thetis/marketplace": "^0.1.0"
  }
}
